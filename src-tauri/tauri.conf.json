{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellnest",
  "identifier": "io.github.justflavio.shellnest",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shellnest",
        "width": 1280,
        "height": 840,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Shellnest contributors",
    "copyright": "Copyright (c) 2026 Shellnest contributors. Released under the MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "SSH client with encrypted vaults",
    "longDescription": "Shellnest is a desktop SSH client for Windows, macOS and Linux: hosts, identities and keys in an encrypted local vault, tabbed terminals with split panes, and optional self-hosted sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JustFlavio/shellnest/releases/download/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMjJFRTgxNzdDRjY3OTcKUldTWFo4OTNnZTRpWHZ4TGlQOXlHRjRuSnJ6cnFId3hTS3dFQnlkV25VTmlsZWJtMHRXOUVhbXcK"
    }
  }
}
