{
  "identifier": "io.github.justflavio.shellnest.e2e",
  "productName": "Shellnest E2E",
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "npm run build -- --mode desktop-e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "desktop-e2e",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
