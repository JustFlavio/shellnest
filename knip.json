{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/**/*.test.ts", "e2e/**/*.ts", "sync/*.ts"],
  "project": ["src/**", "e2e/**", "sync/**"],
  "ignore": ["src/components/ui/**"],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"]
  },
  "ignoreDependencies": [
    "@wdio/cli",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "@wdio/spec-reporter"
  ]
}
